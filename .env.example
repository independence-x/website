# Shop API on DirectAdmin. Use http://127.0.0.1:8787/api to work against the local shop instead.
NEXT_PUBLIC_STORE_API_URL=http://shop.independence-x.com/api

# Payoneer Checkout. Leave blank until Payoneer issues a merchant code and token.
# These stay on the shop server. Do not prefix them with NEXT_PUBLIC_.
# PAYONEER_ENV=sandbox
# PAYONEER_MERCHANT_CODE=
# PAYONEER_PAYMENT_TOKEN=
# PAYONEER_DIVISION=
# STORE_PUBLIC_URL=http://localhost:3000
# Public HTTPS URL of /api/payoneer-notify.php once the shop is on DirectAdmin.
# PAYONEER_NOTIFICATION_URL=
